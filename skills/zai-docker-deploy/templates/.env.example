# Copy this file to .env in the same directory as docker-compose.yml
# and adjust values for your deployment. Keep the defaults neutral so the
# skill remains reusable without exposing project-specific names.

BUILD_ID=local
IMAGE_NAME=zai-app
IMAGE_TAG=local
CONTAINER_NAME=zai-app

# Host-to-container port mappings.
PORT_CADDY=8081:81
PORT_APP=3000:3000

NODE_ENV=production
HOSTNAME=0.0.0.0
DATABASE_URL=file:/app/db/custom.db
RESTART_POLICY=unless-stopped

# Optional named volume for persisted SQLite database.
VOLUME_NAME=zai-app-db

# Optional Compose project name; useful if you want a predictable prefix
# without hard-coding the container name.
COMPOSE_PROJECT_NAME=zai-app
